{
  "name": "cachette-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Cachette design system monorepo.",
  "license": "ISC",
  "author": "Minyeong Jeong",
  "type": "module",
  "scripts": {
    "build-storybook": "pnpm --filter @cachette/docs build-storybook",
    "cachette": "pnpm --filter @cachette/ui build && node packages/ui/dist/cli.js",
    "check": "pnpm oxlint . && pnpm oxfmt --check .",
    "storybook": "pnpm --filter @cachette/docs storybook",
    "typecheck": "pnpm --filter @cachette/tokens typecheck && pnpm --filter @cachette/registry typecheck && pnpm --filter @cachette/cli typecheck && pnpm --filter @cachette/ui typecheck && pnpm --filter @cachette/docs typecheck"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "oxfmt": "catalog:2026-08-27-stable",
    "oxlint": "catalog:2026-08-27-stable",
    "typescript": "catalog:2026-08-27-stable"
  },
  "packageManager": "pnpm@11.23.0"
}
