{
  "name": "nooeh-ui",
  "version": "0.5.0",
  "private": true,
  "description": "Nooeh design system monorepo.",
  "license": "Apache-2.0",
  "author": "Minyeong Jeong",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @nooeh/ui build",
    "build:storybook": "pnpm docs:build",
    "nooeh": "pnpm --filter @nooeh/ui build && node packages/ui/dist/cli.js",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "docs:build": "pnpm --filter @nooeh/docs build-storybook",
    "format:check": "pnpm oxfmt --check .",
    "format:write": "pnpm oxfmt .",
    "lint": "pnpm oxlint .",
    "prepare": "lefthook install",
    "release:check": "pnpm check && pnpm test && pnpm build && pnpm docs:build",
    "release:publish": "node --experimental-strip-types scripts/publish.ts",
    "storybook": "pnpm --filter @nooeh/docs storybook",
    "test": "pnpm --filter @nooeh/cli test && pnpm --filter @nooeh/ui test",
    "typecheck": "pnpm --filter @nooeh/tokens typecheck && pnpm --filter @nooeh/registry build && pnpm --filter @nooeh/cli typecheck && pnpm --filter @nooeh/ui typecheck && pnpm --filter @nooeh/docs typecheck"
  },
  "devDependencies": {
    "lefthook": "2.1.10",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0"
  },
  "packageManager": "pnpm@11.23.0"
}
