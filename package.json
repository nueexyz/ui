{
  "name": "cachette-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Cachette design system monorepo.",
  "license": "ISC",
  "author": "Minyeong Jeong",
  "type": "module",
  "scripts": {
    "build-storybook": "pnpm --filter @cachette/story build-storybook",
    "check": "pnpm oxlint . && pnpm oxfmt --check .",
    "registry:build": "shadcn build registry.json -o .registry",
    "storybook": "pnpm --filter @cachette/story storybook",
    "typecheck": "pnpm --filter @cachette/tokens typecheck && pnpm --filter @cachette/ui typecheck && pnpm --filter @cachette/story typecheck"
  },
  "devDependencies": {
    "oxfmt": "catalog:2026-08-27-stable",
    "oxlint": "catalog:2026-08-27-stable",
    "shadcn": "catalog:2026-08-27-stable",
    "typescript": "catalog:2026-08-27-stable"
  },
  "packageManager": "pnpm@11.23.0"
}
