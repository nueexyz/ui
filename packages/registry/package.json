{
  "name": "@nuee/registry",
  "version": "0.4.2",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/nueexyz/ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --experimental-strip-types scripts/build.ts",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "catalog:2026-08-27-stable"
  }
}
