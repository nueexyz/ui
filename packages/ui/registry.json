{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "global-styles",
      "type": "registry:item",
      "title": "Cachette Global Styles",
      "description": "Global reset styles required by Cachette components.",
      "files": [
        {
          "path": "src/global.css",
          "type": "registry:file",
          "target": "@ui/cachette/global.css"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Accessible Base UI button styled with Cachette tokens and StyleX.",
      "dependencies": ["@base-ui/react", "@stylexjs/stylex", "react"],
      "registryDependencies": ["myjeong19/mds/foundation", "myjeong19/mds/global-styles"],
      "files": [
        {
          "path": "src/button/Button.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/button/Button.tsx"
        },
        {
          "path": "src/button/button.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/button/button.stylex.ts"
        },
        {
          "path": "src/button/index.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/button/index.ts"
        }
      ]
    },
    {
      "name": "input",
      "type": "registry:ui",
      "title": "Input",
      "description": "Accessible Base UI input styled with Cachette tokens and StyleX.",
      "dependencies": ["@base-ui/react", "@stylexjs/stylex", "react"],
      "registryDependencies": ["myjeong19/mds/foundation", "myjeong19/mds/global-styles"],
      "files": [
        {
          "path": "src/input/Input.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/input/Input.tsx"
        },
        {
          "path": "src/input/input.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/input/input.stylex.ts"
        },
        {
          "path": "src/input/index.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/input/index.ts"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card",
      "description": "Composable card surface styled with Cachette tokens and StyleX.",
      "dependencies": ["@stylexjs/stylex", "react"],
      "registryDependencies": ["myjeong19/mds/foundation", "myjeong19/mds/global-styles"],
      "files": [
        {
          "path": "src/card/Card.tsx",
          "type": "registry:ui",
