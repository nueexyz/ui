{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "include": [
    "./src/accordion/registry.json",
    "./src/alert/registry.json",
    "./src/alert-dialog/registry.json",
    "./src/aspect-ratio/registry.json",
    "./src/attachment/registry.json",
    "./src/avatar/registry.json",
    "./src/badge/registry.json",
    "./src/button/registry.json",
    "./src/button-group/registry.json",
    "./src/bubble/registry.json",
    "./src/breadcrumb/registry.json",
    "./src/card/registry.json",
    "./src/dialog/registry.json",
    "./src/direction/registry.json",
    "./src/checkbox/registry.json",
    "./src/collapsible/registry.json",
    "./src/combobox/registry.json",
    "./src/context-menu/registry.json",
    "./src/dropdown-menu/registry.json",
    "./src/empty/registry.json",
    "./src/field/registry.json",
    "./src/hover-card/registry.json",
    "./src/input/registry.json",
    "./src/input-group/registry.json",
    "./src/input-otp/registry.json",
    "./src/item/registry.json",
    "./src/kbd/registry.json",
    "./src/label/registry.json",
    "./src/menubar/registry.json",
    "./src/marker/registry.json",
    "./src/message/registry.json",
    "./src/message-scroller/registry.json",
    "./src/native-select/registry.json",
    "./src/navigation-menu/registry.json",
    "./src/popover/registry.json",
    "./src/pagination/registry.json",
    "./src/progress/registry.json",
    "./src/radio-group/registry.json",
    "./src/scroll-area/registry.json",
    "./src/separator/registry.json",
    "./src/select/registry.json",
    "./src/skeleton/registry.json",
    "./src/slider/registry.json",
    "./src/spinner/registry.json",
    "./src/switch/registry.json",
    "./src/table/registry.json",
    "./src/tabs/registry.json",
    "./src/textarea/registry.json",
    "./src/toast/registry.json",
    "./src/toggle/registry.json",
    "./src/toggle-group/registry.json",
    "./src/typography/registry.json",
    "./src/tooltip/registry.json"
  ],
  "items": [
    {
      "name": "global-styles",
      "type": "registry:item",
      "title": "Cachette Global Styles",
      "description": "Global reset styles required by Cachette components.",
      "files": [
        {
          "path": "src/global.css",
          "type": "registry:file",
          "target": "@ui/cachette/global.css"
        }
      ]
    },
    {
      "name": "icon",
      "type": "registry:ui",
      "title": "Icon",
      "description": "Thin-weight Phosphor icon registry for Cachette interfaces.",
      "dependencies": ["@phosphor-icons/react", "react"],
      "files": [
        {
          "path": "src/Icon.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/Icon.tsx"
        }
      ]
    }
  ]
}
