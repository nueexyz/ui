        },
        {
          "path": "src/card/card.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/card/card.stylex.ts"
        },
        {
          "path": "src/card/index.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/card/index.ts"
        }
      ]
    },
    {
      "name": "icon",
      "type": "registry:ui",
      "title": "Icon",
      "description": "Thin-weight Phosphor icon registry for Cachette interfaces.",
      "dependencies": ["@phosphor-icons/react", "react"],
      "files": [
        {
          "path": "src/Icon.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/Icon.tsx"
