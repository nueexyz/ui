{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "card",
      "type": "registry:ui",
      "title": "Card",
      "description": "Composable card surface styled with Cachette tokens and StyleX.",
      "dependencies": ["@stylexjs/stylex", "react"],
      "registryDependencies": ["myjeong19/mds/foundation", "myjeong19/mds/global-styles"],
      "files": [
        { "path": "Card.tsx", "type": "registry:ui", "target": "@ui/cachette/card/Card.tsx" },
        {
          "path": "card.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/card/card.stylex.ts"
        },
        { "path": "index.ts", "type": "registry:ui", "target": "@ui/cachette/card/index.ts" }
      ]
    }
  ]
}
