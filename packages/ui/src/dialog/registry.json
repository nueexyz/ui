      "files": [
        { "path": "Dialog.tsx", "type": "registry:ui", "target": "@ui/cachette/dialog/Dialog.tsx" },
        {
          "path": "dialog.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/dialog/dialog.stylex.ts"
        },
        { "path": "index.ts", "type": "registry:ui", "target": "@ui/cachette/dialog/index.ts" }
      ]
    }
  ]
