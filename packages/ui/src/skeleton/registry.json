{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "skeleton",
      "type": "registry:ui",
      "title": "Skeleton",
      "description": "Placeholder that preserves layout while content loads.",
      "dependencies": ["@stylexjs/stylex", "react"],
      "registryDependencies": ["myjeong19/mds/foundation", "myjeong19/mds/global-styles"],
      "files": [
        {
          "path": "Skeleton.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/skeleton/Skeleton.tsx"
        },
        {
          "path": "skeleton.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/skeleton/skeleton.stylex.ts"
        },
        { "path": "index.ts", "type": "registry:ui", "target": "@ui/cachette/skeleton/index.ts" }
      ]
    }
  ]
}
