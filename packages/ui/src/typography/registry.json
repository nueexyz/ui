{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "typography",
      "type": "registry:ui",
      "title": "Typography",
      "description": "Semantic text styles backed by Cachette typography and color tokens.",
      "dependencies": ["@stylexjs/stylex", "react"],
      "registryDependencies": ["myjeong19/mds/foundation", "myjeong19/mds/global-styles"],
      "files": [
        {
          "path": "Typography.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/typography/Typography.tsx"
        },
        {
          "path": "typography.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/typography/typography.stylex.ts"
        },
        { "path": "index.ts", "type": "registry:ui", "target": "@ui/cachette/typography/index.ts" }
      ]
    }
  ]
}
