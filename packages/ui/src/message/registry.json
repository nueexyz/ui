{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "message",
      "type": "registry:ui",
      "title": "Message",
      "description": "대화의 작성자, 내용, 시간과 관련 행동을 구조화합니다.",
      "dependencies": ["@stylexjs/stylex", "react"],
      "registryDependencies": ["myjeong19/mds/foundation", "myjeong19/mds/global-styles"],
      "files": [
        {
          "path": "Message.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/message/Message.tsx"
        },
        {
          "path": "message.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/message/message.stylex.ts"
        },
        { "path": "index.ts", "type": "registry:ui", "target": "@ui/cachette/message/index.ts" }
      ]
    }
  ]
}
