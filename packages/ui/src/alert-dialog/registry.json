{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "alert-dialog",
      "type": "registry:ui",
      "title": "Alert Dialog",
      "description": "Accessible confirmation dialog that requires an explicit response.",
      "dependencies": ["@base-ui/react", "@stylexjs/stylex", "react"],
      "registryDependencies": [
        "myjeong19/mds/button",
        "myjeong19/mds/foundation",
        "myjeong19/mds/global-styles"
      ],
      "files": [
        {
          "path": "AlertDialog.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/alert-dialog/AlertDialog.tsx"
        },
        {
          "path": "alert-dialog.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/alert-dialog/alert-dialog.stylex.ts"
        },
        {
          "path": "index.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/alert-dialog/index.ts"
        }
      ]
    }
  ]
}
