{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "progress",
      "type": "registry:ui",
      "title": "Progress",
      "description": "Accessible determinate or indeterminate task progress.",
      "dependencies": ["@base-ui/react", "@stylexjs/stylex", "react"],
      "registryDependencies": ["myjeong19/mds/foundation", "myjeong19/mds/global-styles"],
      "files": [
        {
          "path": "Progress.tsx",
          "type": "registry:ui",
          "target": "@ui/cachette/progress/Progress.tsx"
        },
        {
          "path": "progress.stylex.ts",
          "type": "registry:ui",
          "target": "@ui/cachette/progress/progress.stylex.ts"
        },
        { "path": "index.ts", "type": "registry:ui", "target": "@ui/cachette/progress/index.ts" }
      ]
    }
  ]
}
