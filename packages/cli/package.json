{
  "name": "@nooeh/cli",
  "version": "0.0.1",
  "private": false,
  "bin": {
    "nooeh": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm --filter @nooeh/registry build && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "pnpm build && node test/cli.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nooeh/registry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "catalog:2026-08-27-stable"
  }
}
